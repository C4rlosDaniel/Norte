# Ambiente — copie para .env.local e preencha.
# NUNCA versione .env.local nem coloque segredos reais neste arquivo de exemplo.

# ---------- App ----------
NODE_ENV=development
APP_URL=http://localhost:3000
RESTAURANT_SLUG=amigos-do-norte
LOG_LEVEL=info

# ---------- Banco (Supabase) ----------
# Runtime: pooler em modo transaction (porta 6543). O app usa prepare=false.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrações: conexão direta (porta 5432). Nunca use a porta 6543 para DDL.
DIRECT_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres

# ---------- Supabase Auth (somente servidor) ----------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...chave-anon...

# ---------- Scripts administrativos (opcional, nunca no browser) ----------
# Necessária apenas para ADMIN_EMAIL no script create:admin.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=dono@restaurante.com
# ADMIN_PASSWORD=escolha-uma-senha-forte

# ---------- WhatsApp (Fase 5 — deixe comentado até lá) ----------
# WHATSAPP_PROVIDER=simulated
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_CONFIRMATION=pedido_confirmado
# WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=pedido_saiu_para_entrega
# WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------- Proteções (Fase 3+) ----------
# TURNSTILE_SECRET_KEY=
# WORKER_SECRET=

# ---------- E2E (apenas para npm run test:e2e) ----------
# E2E_EMAIL=dono@restaurante.com
# E2E_PASSWORD=senha-do-painel
# E2E_BASE_URL=http://127.0.0.1:3100
# E2E_RESTAURANT_NAME=Amigos do Norte
